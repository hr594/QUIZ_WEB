# Frontend (Vite) - Required for live Supabase integration
# If left blank, the app will run in offline / interactive demo mode.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_APP_URL=https://yourdomain.com
VITE_BACKEND_URL=https://quiz-web-8fkf.onrender.com

# Backend / Supabase Edge Functions (Set in Supabase Dashboard -> Settings -> API / Secrets)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# RESEND_API_KEY=re_123456789
# WHATSAPP_API_KEY=your_whatsapp_provider_key
